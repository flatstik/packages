# VeraCrypt volumes. luci-app-veracrypt edits the same sections.

config settings 'main'
	# Timeout in seconds for operations started from a web interface.
	option timeout '300'
	# option token_lib '/usr/lib/libykcs11.so'

# On demand: "/etc/init.d/veracrypt start data" asks for the password on a
# terminal; LuCI asks for it in the browser.
# config volume 'data'
#	option auto_mount '0'
#	option volume '/mnt/sda1/data.hc'
#	option mountpoint '/mnt/data'
#	option pim '0'
#	option mount_options 'nokernelcrypto'
#	option read_only '0'

# Unattended mount at boot and when the disk appears. This needs the secret
# on the router: password_file holds the password in plain text (its first
# line is used), and keyfiles are as secret. Both must be root-only files
# (chmod 600) below directories only root can write to, so not directly in
# /tmp (use e.g. /tmp/veracrypt with chmod 700) and not on FAT/exFAT/NTFS
# sticks, whose files are not root-only. Anyone who gets the router or
# these files can open the volume. Never put the password itself in UCI.
# Add the files to /etc/sysupgrade.conf to keep them across a sysupgrade.
# config volume 'backup'
#	option auto_mount '1'
#	option volume '/dev/sda2'
#	option mountpoint '/mnt/backup'
#	option password_file '/etc/veracrypt/passwords/backup'
#	option keyfiles '/etc/veracrypt/keyfiles/backup.key'
#	option pim '0'
#	option mount_options 'nokernelcrypto'
#	option read_only '0'

# Keyfiles only, with an intentionally empty password (never implied):
#	option empty_password '1'
